<local:ChromeWindow x:Class="Lolia.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Lolia.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Icon="Assets/logo.ico" Title="洛链绽放 · Lolia Bloom" Height="820" Width="1320" MinHeight="700" MinWidth="1140" Background="#F9F5FA">
<Border BorderBrush="#EADDE8" BorderThickness="1" CornerRadius="16"><Grid>
<Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="#FFFCFE" BorderBrush="#EFE5ED" BorderThickness="0,0,0,1"><Grid Margin="20,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:BrandLogo Width="30" Height="30"/><TextBlock Text="洛链绽放" FontWeight="SemiBold" Margin="10,0,14,0" VerticalAlignment="Center"/><TextBlock Text="L O L I A   B L O O M" FontSize="10" Foreground="#B29AAC" VerticalAlignment="Center"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource CaptionButton}" Content="─" Click="Minimize_Click" ToolTip="最小化"/><Button Style="{StaticResource CaptionButton}" Content="□" Click="Maximize_Click" ToolTip="最大化 / 还原"/><Button Style="{StaticResource CaptionButton}" Content="×" Click="Close_Click" ToolTip="关闭窗口，后台隧道继续运行"/></StackPanel>
</Grid></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#342338" CornerRadius="0,0,0,15"><DockPanel Margin="20,26,20,20">
<StackPanel DockPanel.Dock="Top"><TextBlock Text="BLOOM NETWORK" Foreground="#C09EB7" FontSize="10" Margin="12,0,0,24"/><Button Style="{StaticResource NavButton}" Background="#624055" Foreground="White" Content="◈    隧道工作台"/><Button Style="{StaticResource NavButton}" Content="＋    创建隧道" Click="Create_Click"/><TextBlock Text="管理与服务" Foreground="#97788F" FontSize="11" Margin="12,28,0,8"/><Button Style="{StaticResource NavButton}" Content="↗    更新 FRP" Click="UpdateFrp_Click"/><Button Style="{StaticResource NavButton}" Content="⊖    卸载后台服务" Click="Uninstall_Click"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Border Background="#453047" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="来领取一点好心情" Foreground="#F0DDEB" FontWeight="SemiBold"/><TextBlock Name="CheckinStatus" Text="登录后查看签到状态" Foreground="#BEA2B5" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,12"/><Button Content="自动签到 / 官网登录" Click="Checkin_Click" Background="#79526C" Padding="8,9" FontSize="11"/></StackPanel></Border><TextBlock Name="AppVersion" FontSize="10" Foreground="#97788F" Margin="12,14,0,0" Text="v—"/></StackPanel><Grid/>
</DockPanel></Border>
<Grid Grid.Column="1" Margin="30,25,30,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="连接，从这里绽放。" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="管理你的隧道，让每一次连接都从容有序。" Foreground="#A18C9D" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1" Width="340" Margin="20,0,0,0">
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Name="ServiceButton" Width="210" FontSize="12" Content="① 安装后台服务" Click="Install_Click" Background="#694971" FontWeight="SemiBold" Padding="18,11" Margin="0,0,9,0"/><Button Content="登录账号  ↗" Click="Login_Click" Style="{StaticResource Secondary}"/></StackPanel>
<Grid Name="ServiceGuide" Margin="0,7,0,0"><Grid.RowDefinitions><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Polygon Points="110,10 122,0 134,10" Fill="#FFF2D5" Stroke="#EBD3A1" StrokeThickness="1"/><Border Grid.Row="1" Background="#FFF2D5" BorderBrush="#EBD3A1" BorderThickness="1" CornerRadius="13" Padding="15,12"><StackPanel><TextBlock Name="GuideTitle" Text="第一次使用，请先点上面的按钮" FontWeight="SemiBold" Foreground="#926329" FontSize="12"/><TextBlock Name="GuideDescription" Text="安装后台服务后，隧道才能启动。请在 Windows 提示时允许管理员授权。" TextWrapping="Wrap" Foreground="#AA844E" FontSize="11" Margin="0,5,0,0"/><Expander Name="InstallLogPanel" Header="诊断与日志（可复制）" Visibility="Collapsed" Margin="0,10,0,0" Foreground="#926329"><StackPanel><TextBox Name="InstallLogText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="150" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="复制日志" Click="CopyInstallLog_Click" Style="{StaticResource Secondary}" Margin="0,0,8,0"/><Button Content="打开日志文件" Click="OpenInstallLog_Click" Style="{StaticResource Secondary}" Margin="0,0,8,0"/><Button Content="收起反馈" Click="DismissDiagnostics_Click" Style="{StaticResource Secondary}"/></StackPanel></StackPanel></Expander></StackPanel></Border></Grid>
</StackPanel></Grid>
<UniformGrid Grid.Row="1" Columns="3" Margin="0,25,0,24"><Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="↓  本地下载速率" Foreground="#A18C9D"/><TextBlock Name="GlobalDownload" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="#CF538F"/><local:TrafficChart x:Name="DownloadChart" Height="58" Margin="0,8,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="↑  本地上传速率" Foreground="#A18C9D"/><TextBlock Name="GlobalUpload" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="#8565A5"/><local:TrafficChart x:Name="UploadChart" Height="58" Margin="0,8,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="15" Padding="20"><StackPanel><TextBlock Text="◉  正在运行" Foreground="#A18C9D"/><TextBlock Name="RunningCount" Text="0 / 0" FontSize="27" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="账号流量 · 平台统计" Foreground="#A18C9D" Margin="0,12,0,0"/><TextBlock Name="AccountTrafficRemaining" Text="剩余 —" Foreground="#CF538F" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Name="AccountTrafficSummary" Text="已用 — · 总额 —" FontSize="11" Foreground="#8565A5" Margin="0,4,0,0"/><TextBlock Name="AccountTrafficStatus" Text="登录后获取" FontSize="10" Foreground="#A18C9D" Margin="0,4,0,0"/></StackPanel></Border></UniformGrid>
<Border Grid.Row="2" Background="White" CornerRadius="16" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="我的隧道" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="本地速率每秒刷新 · 累计流量来自平台" FontSize="11" Foreground="#AD98A7" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="↻" Click="Refresh_Click" Style="{StaticResource Secondary}" Margin="0,0,8,0" ToolTip="刷新状态与平台流量"/><Button Content="同步" Click="Sync_Click" Style="{StaticResource Secondary}" Margin="0,0,8,0"/><Button Content="＋ 创建隧道" Click="Create_Click"/></StackPanel></Grid>
<DataGrid Grid.Row="1" Name="TunnelGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
<DataGrid.Columns>
<DataGridTemplateColumn Header="隧道 / 本地服务" Width="1.4*" MinWidth="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LocalAddress}" Foreground="#AB97A6" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="访问地址" Width="1.8*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><Button Content="{Binding RemoteAddress}" Tag="{Binding RemoteAddress}" Click="CopyAddress_Click" Background="Transparent" Foreground="#B6467E" Padding="0" HorizontalContentAlignment="Left" ToolTip="点击复制完整访问地址"/><TextBlock Text="{Binding Type}" FontSize="10" Foreground="#AA97A4" Margin="0,6,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="↓ 下载 / ↑ 上传" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel ToolTip="{Binding MetricsSource}"><TextBlock Text="{Binding DownloadText}"/><TextBlock Text="{Binding UploadText}" Foreground="#A28E9E" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="平台累计 ↓ / ↑" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding TotalInText}"/><TextBlock Text="{Binding TotalOutText}" Foreground="#A28E9E" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="状态" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,7,0"/><TextBlock Text="{Binding StateText}" FontSize="12"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="开机连接" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel HorizontalAlignment="Center"><ToggleButton Style="{StaticResource CapsuleSwitch}" IsChecked="{Binding AutoStart,Mode=OneWay}" Tag="{Binding Id}" Click="AutoToggle_Click" ToolTip="仅设置这条隧道：下次后台服务启动时自动连接。关闭开关不会停止当前隧道。"/><TextBlock ToolTip="{Binding StartupStatus}" Text="{Binding AutoText}" Foreground="#A38D9F" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="操作" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding ToggleText}" Tag="{Binding Id}" Click="ToggleRow_Click" Padding="10,7" Background="{Binding ActionBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="1" Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="◈" FontSize="42" Foreground="#EDD6E5" HorizontalAlignment="Center"/><TextBlock Text="让第一条隧道，连接你的世界。" Foreground="#AC96A6" Margin="0,15,0,0"/><TextBlock Text="登录后同步隧道，或创建一个新的连接。" Foreground="#C5B2C0" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel>
<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="隧道详情" Click="Details_Click" Style="{StaticResource Secondary}" FontSize="11" Padding="12,8" Margin="0,0,8,0"/><Button Content="复制访问地址" Click="CopySelected_Click" Style="{StaticResource Secondary}" FontSize="11" Padding="12,8"/><Button Content="诊断与报错" Click="Diagnostics_Click" Style="{StaticResource Secondary}" FontSize="11" Padding="12,8" Margin="8,0,0,0"/></StackPanel>
</Grid></Border>
<TextBlock Grid.Row="3" Name="Status" Foreground="#AA8DA1" FontSize="11" Text="正在连接后台服务…" TextWrapping="Wrap" Margin="2,13,0,0"/>
</Grid></Grid></Grid></Border></local:ChromeWindow>
