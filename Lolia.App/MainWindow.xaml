<Window x:Class="Lolia.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="洛链绽放 · Lolia Bloom" Height="700" Width="1180" MinHeight="520" MinWidth="900" Background="#FFFBFD">
<DockPanel Margin="18">
<StackPanel DockPanel.Dock="Top">
<TextBlock Text="🌸 洛链绽放 · Lolia Bloom" FontSize="27" FontWeight="Bold" Foreground="#D63378"/>
<TextBlock Text="账号隧道管理 · Windows 后台服务 · 关闭界面不断线" Foreground="Gray" Margin="0,3,0,14"/>
<Border Background="#FFF0F5" CornerRadius="10" Padding="12" Margin="0,0,0,12">
<StackPanel>
<TextBlock Text="🌸 每日签到" FontWeight="Bold" FontSize="17" Foreground="#D63378"/>
<TextBlock Name="CheckinStatus" Text="请登录后查询今日签到状态" Margin="0,6,0,8" Foreground="#8F4168"/>
<WrapPanel>
<Button Content="手动签到" Click="Checkin_Click"/>
<CheckBox Name="AutoCheckin" Content="自动签到（程序运行时，每小时检查重试）" VerticalAlignment="Center" Margin="12,0,0,0"/>
</WrapPanel>
</StackPanel>
</Border>
<WrapPanel Margin="0,0,0,12">
<Button Content="登录账号" Click="Login_Click" Padding="12,8" Margin="0,0,8,0"/>
<Button Content="同步隧道" Click="Sync_Click" Padding="12,8" Margin="0,0,8,0"/>
<Button Content="↻ 刷新流量与状态" Click="Refresh_Click" Padding="12,8" Margin="0,0,8,0"/>
<Button Content="创建隧道" Click="Create_Click" Padding="12,8" Margin="0,0,8,0"/>
<Button Content="一键安装后台服务" Click="Install_Click" Padding="12,8" Margin="0,0,8,0"/>
<Button Content="卸载后台服务" Click="Uninstall_Click" Padding="12,8"/>
</WrapPanel>
<TextBlock Name="Status" Foreground="#B43870" Text="正在检查服务" TextWrapping="Wrap" Margin="0,0,0,5"/>
<TextBlock Text="流量来自官方接口；速度按累计流量与服务端更新时间差分估算，首次采样显示 —。" Foreground="Gray" Margin="0,0,0,12"/>
</StackPanel>
<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="查看选中隧道详情" Click="Details_Click" Padding="14,8" Margin="0,0,8,0"/><Button Content="设置/取消开机连接" Click="Auto_Click" Padding="14,8"/></StackPanel>
<DataGrid Name="TunnelGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" RowHeight="43" AlternationCount="2">
<DataGrid.Columns>
<DataGridTextColumn Header="隧道名称" Binding="{Binding Name}" Width="1.7*"/>
<DataGridTextColumn Header="协议" Binding="{Binding Type}" Width="70"/>
<DataGridTextColumn Header="下载估算" Binding="{Binding DownloadText}" Width="110"/>
<DataGridTextColumn Header="上传估算" Binding="{Binding UploadText}" Width="110"/>
<DataGridTextColumn Header="累计下载" Binding="{Binding TotalInText}" Width="110"/>
<DataGridTextColumn Header="累计上传" Binding="{Binding TotalOutText}" Width="110"/>
<DataGridTextColumn Header="连接状态" Binding="{Binding StateText}" Width="95"/>
<DataGridCheckBoxColumn Header="开机连接" Binding="{Binding AutoStart}" Width="85"/>
<DataGridTemplateColumn Header="操作" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding ToggleText}" Tag="{Binding Id}" Click="ToggleRow_Click" Padding="8,5" Margin="5,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns>
</DataGrid>
</DockPanel></Window>