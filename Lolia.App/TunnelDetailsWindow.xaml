<local:ChromeWindow x:Class="Lolia.App.TunnelDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Lolia.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="隧道详情 · 洛链绽放" Width="800" Height="780" MinWidth="700" MinHeight="680" Background="#FAF7FB" WindowStartupLocation="CenterOwner" Icon="Assets/logo.ico">
<Border BorderBrush="#EADDE8" BorderThickness="1" CornerRadius="16"><Grid><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
<Grid Background="#FFFCFE"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0"><Image Source="Assets/logo.png" Width="28" Height="28"/><TextBlock Text="连接详情" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource CaptionButton}" Content="×" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,12,0"/></Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20,24,0">
<Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Name="TunnelName" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Name="Subtitle" Foreground="#A38D9F" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Background="#F5E8F0" CornerRadius="14" Padding="13,8" VerticalAlignment="Top" Margin="15,0,0,0"><StackPanel Orientation="Horizontal"><Ellipse Name="StateDot" Width="7" Height="7" Margin="0,0,7,0"/><TextBlock Name="StateLabel"/></StackPanel></Border></Grid>
<Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="访问地址" Foreground="#A38D9F" FontSize="11"/><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Name="Address" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,7" FontSize="16" Foreground="#C74685"/><Button Grid.Column="1" Content="复制地址" Click="Copy_Click" Style="{StaticResource Secondary}" Padding="12,8" Margin="12,0,0,0"/></Grid><Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本地服务" Foreground="#A38D9F" FontSize="11"/><TextBlock Name="Local" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="开机连接" Foreground="#A38D9F" FontSize="11"/><TextBlock Name="Startup" Margin="0,6,0,0"/></StackPanel></Grid></StackPanel></Border>
<UniformGrid Columns="2" Margin="0,0,0,14"><Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,7,0"><StackPanel><TextBlock Text="↓ 本地下载" Foreground="#A38D9F"/><TextBlock Name="Download" Foreground="#CF538F" FontSize="23" Margin="0,8,0,5"/><local:TrafficChart Name="DownloadChart" Height="90"/><TextBlock Name="TotalIn" Foreground="#A38D9F" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="14" Padding="18" Margin="7,0,0,0"><StackPanel><TextBlock Text="↑ 本地上传" Foreground="#A38D9F"/><TextBlock Name="Upload" Foreground="#8565A5" FontSize="23" Margin="0,8,0,5"/><local:TrafficChart Name="UploadChart" Height="90"/><TextBlock Name="TotalOut" Foreground="#A38D9F" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid>
<Border Background="White" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="连接备注" Foreground="#A38D9F" FontSize="11"/><TextBlock Name="Description" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Name="Metrics" Margin="0,13,0,0" Foreground="#AA97A5" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
</StackPanel></ScrollViewer><TextBlock Grid.Row="2" Name="Feedback" Text="最近 60 秒 · 本窗口打开后开始记录 · 每秒刷新" Foreground="#A38D9F" FontSize="11" Margin="25,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
</Grid></Border></local:ChromeWindow>
