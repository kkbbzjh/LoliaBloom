<local:ChromeWindow x:Class="Lolia.App.CreateTunnelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Lolia.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="创建云端隧道 · 洛链绽放" Width="1040" Height="790" MinWidth="980" MinHeight="740" Background="#FAF7FB" WindowStartupLocation="CenterOwner" Icon="Assets/logo.ico">
<Border BorderBrush="#EADDE8" BorderThickness="1" CornerRadius="16"><Grid><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
<Grid Background="#FFFCFE" Margin="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0"><Image Source="Assets/logo.png" Width="28" Height="28"/><TextBlock Text="创建一个新连接" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="1" Style="{StaticResource CaptionButton}" Content="×" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,12,0"/></Grid>
<Grid Grid.Row="1" Margin="24,24,24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="White" CornerRadius="16" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="01   选择节点" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="找到适合你的那一个连接位置。" Foreground="#A38D9F" Margin="0,7,0,18"/></StackPanel>
<Grid Grid.Row="1" Margin="0,0,0,12"><TextBox Name="search" ToolTip="搜索节点名称或地区"/><TextBlock Text="搜索节点名称或地区…" Foreground="#BBA8B5" Margin="13,11,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
<StackPanel Grid.Row="2" Margin="0,0,0,15"><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox Name="region"/><CheckBox Name="onlineOnly" Grid.Column="1" Content="仅看在线" IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="协议分类" Foreground="#7C6578" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox Name="nodeProtocol" Grid.Column="1" SelectedIndex="0" ToolTip="按支持的协议筛选节点，同时设置隧道协议"><ComboBoxItem Content="TCP" Tag="tcp"/><ComboBoxItem Content="UDP" Tag="udp"/><ComboBoxItem Content="HTTP" Tag="http"/><ComboBoxItem Content="HTTPS" Tag="https"/></ComboBox></Grid></StackPanel>
<Grid Grid.Row="3"><ListBox Name="NodeList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"><Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#A38D9F"/></StackPanel></Grid><TextBlock Text="{Binding Subtitle}" Foreground="#A38D9F" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Name="EmptyNodes" Text="没有匹配的节点，试试其他筛选条件。" TextWrapping="Wrap" Foreground="#A38D9F" Margin="15" Visibility="Collapsed"/></Grid>
</Grid></Border>
<Border Grid.Column="2" Background="White" CornerRadius="16" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="02   配置隧道" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="填写本地服务，剩下的交给连接。" Foreground="#A38D9F" Margin="0,7,0,21"/>
<TextBlock Text="连接协议" Foreground="#7C6578" Margin="0,0,0,7"/><ComboBox Name="protocol" SelectedIndex="0"><ComboBoxItem Content="TCP · 通用端口映射" Tag="tcp"/><ComboBoxItem Content="UDP · 实时数据传输" Tag="udp"/><ComboBoxItem Content="HTTP · 网站访问" Tag="http"/><ComboBoxItem Content="HTTPS · 加密网站访问" Tag="https"/></ComboBox>
<Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本地 IP 地址" Foreground="#7C6578" Margin="0,0,0,7"/><TextBox Name="ip" Text="127.0.0.1"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="本地端口" Foreground="#7C6578" Margin="0,0,0,7"/><TextBox Name="port" Text="80"/></StackPanel></Grid>
<TextBlock Text="远程端口" Foreground="#7C6578" Margin="0,18,0,7"/><TextBox Name="remote"/><TextBlock Text="TCP / UDP 留空时，由节点自动分配。" FontSize="10" Foreground="#B29DAD" Margin="0,5,0,0"/>
<TextBlock Text="自定义域名" Foreground="#7C6578" Margin="0,18,0,7"/><TextBox Name="domain"/><TextBlock Text="HTTP / HTTPS 必填，需先在官网完成域名验证。" FontSize="10" Foreground="#B29DAD" Margin="0,5,0,0"/>
<TextBlock Text="隧道备注" Foreground="#7C6578" Margin="0,18,0,7"/><TextBox Name="remark" MaxLength="500"/>
<Border Background="#FFF3F8" CornerRadius="10" Padding="12" Margin="0,18,0,0"><TextBlock Name="help" TextWrapping="Wrap" Foreground="#AF6C90" FontSize="11"/></Border>
</StackPanel></ScrollViewer></Border>
</Grid>
<Grid Grid.Row="2" Margin="26,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Name="SelectionInfo" Text="请选择一个节点" Foreground="#A38D9F" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="取消" Click="Close_Click" Style="{StaticResource Secondary}" Margin="0,0,10,0"/><Button Name="create" Content="创建隧道  →" Padding="24,12"/></StackPanel></Grid>
</Grid></Border></local:ChromeWindow>
