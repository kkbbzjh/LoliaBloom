# Generate a strong password with: openssl rand -base64 32
LOLIABLOOM_ADMIN_PASSWORD=replace-with-a-random-secret-of-at-least-16-characters

# Set this to the exact URL users open. For public access, use your HTTPS domain.
LOLIABLOOM_PUBLIC_URL=http://192.168.1.10:8080
LOLIABLOOM_PORT=8080
LOLIABLOOM_BIND=0.0.0.0

# OAuth callback must be allowed for this OAuth client by Lolia's authorization service.
# Leave blank to use ${LOLIABLOOM_PUBLIC_URL}/auth/callback.
LOLIABLOOM_OAUTH_REDIRECT_URL=
LOLIA_OAUTH_CLIENT_ID=3k9iwlin05pwdv7g
